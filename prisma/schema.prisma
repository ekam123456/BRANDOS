generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KnowledgeType {
  FACT
  OBSERVATION
  ASSUMPTION
  HYPOTHESIS
  DECISION
  OUTCOME
}

enum SourceType {
  USER
  ONBOARDING
  WEBSITE
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  GOOGLE_ANALYTICS
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ADS
  META_ADS
  SHOPIFY
  STRIPE
  CRM
  EMAIL
  RESEARCH
  SYSTEM
}

model UserAccount {
  id             String       @id
  email          String?
  displayName    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  auditEvents    AuditEvent[] @relation("AuditActor")
}

model Organization {
  id             String              @id
  name           String
  slug           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  memberships    Membership[]
  business       Business?
  profiles       BusinessProfile[]
  goals          BusinessGoal[]
  brandConfig    BrandConfiguration?
  auditEvents    AuditEvent[]
  onboardingProgress OnboardingProgress?
  products       Product[]
  services       Service[]
  customerSegments CustomerSegment[]
  competitors    Competitor[]
  metrics        BusinessMetric[]
  observations   Observation[]
  problems       Problem[]
  opportunities  Opportunity[]
  recommendations Recommendation[]
  tasks          Task[]
}

model Membership {
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@id([organizationId, userId])
  @@index([userId])
}

model Role {
  id           String         @id @default(cuid())
  organizationId String?
  key          String
  name         String
  createdAt    DateTime       @default(now())
  memberships  Membership[]
  permissions  RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Permission {
  id          String         @id @default(cuid())
  key         String         @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Business {
  id             String          @id @default(cuid())
  organizationId String          @unique
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        BusinessProfile?
  goals          BusinessGoal[]
  products       Product[]
  services       Service[]
  customerSegments CustomerSegment[]
  competitors    Competitor[]
  metrics        BusinessMetric[]
  observations   Observation[]
  problems       Problem[]
  opportunities  Opportunity[]
  recommendations Recommendation[]
  tasks          Task[]

  @@unique([id, organizationId])
}

model BusinessProfile {
  id          String   @id @default(cuid())
  businessId  String   @unique
  organizationId String
  industry    String?
  description String?
  website     String?
  category    String?
  niche       String?
  businessType String?
  businessStage String?
  location    String?
  operatingMarket String?
  businessModel String?
  targetMarket String?
  primaryChannels Json?
  currentChallenges String?
  resourcesContext String?
  launchInformation String?
  idea          String?
  targetCustomer String?
  problem       String?
  proposedSolution String?
  assumptions   String?
  openQuestions String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([businessId, organizationId])
  @@index([organizationId])
}

model BusinessGoal {
  id          String   @id @default(cuid())
  businessId  String
  organizationId String
  title       String
  description String?
  goalType    String?
  target      String?
  timeframe   String?
  priority    Int?
  isPrimary   Boolean   @default(false)
  sourceType  SourceType @default(ONBOARDING)
  knowledgeType KnowledgeType @default(FACT)
  problems      Problem[]
  opportunities Opportunity[]
  recommendations Recommendation[]
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([organizationId])
}

model OnboardingProgress {
  id             String   @id @default(cuid())
  organizationId String   @unique
  step           String
  draft          Json
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  name           String
  description    String?
  category       String?
  price          String?
  status         String?
  sourceType     SourceType @default(USER)
  knowledgeType  KnowledgeType @default(FACT)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  confidence     String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([businessId])
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  name           String
  description    String?
  category       String?
  price          String?
  status         String?
  sourceType     SourceType @default(USER)
  knowledgeType  KnowledgeType @default(FACT)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  confidence     String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([businessId])
}

model CustomerSegment {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  name           String
  description    String?
  needsProblems  String?
  characteristics String?
  acquisitionContext String?
  priority       Int?
  sourceType     SourceType @default(USER)
  knowledgeType  KnowledgeType @default(FACT)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  confidence     String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([businessId])
}

model Competitor {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  name           String
  website        String?
  description    String?
  context        String?
  sourceType     SourceType @default(USER)
  knowledgeType  KnowledgeType @default(FACT)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  confidence     String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([businessId])
}

model BusinessMetric {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  name           String
  value          String?
  unit           String?
  period         String?
  source         String?
  measuredAt     DateTime?
  freshness      String?
  sourceType     SourceType @default(USER)
  knowledgeType  KnowledgeType @default(FACT)
  sourceReference String?
  collectedAt    DateTime?
  confidence     String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([businessId])
}

model Observation {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  title          String
  description    String?
  evidence       String?
  status         String?
  sourceType     SourceType @default(USER)
  knowledgeType  KnowledgeType @default(OBSERVATION)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  confidence     String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  problems       Problem[]
  recommendations Recommendation[]
  opportunities  Opportunity[]
  @@index([organizationId])
  @@index([businessId])
}

model Problem {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  observationId  String?
  goalId         String?
  title          String
  description    String?
  evidence       String?
  status         String?
  confidence     String?
  sourceType     SourceType @default(USER)
  knowledgeType  KnowledgeType @default(OBSERVATION)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  observation    Observation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  goal           BusinessGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  opportunities  Opportunity[]
  recommendations Recommendation[]
  @@index([organizationId])
  @@index([businessId])
}

model Opportunity {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  observationId  String?
  problemId      String?
  goalId         String?
  title          String
  description    String?
  evidence       String?
  status         String?
  confidence     String?
  sourceType     SourceType @default(USER)
  knowledgeType  KnowledgeType @default(HYPOTHESIS)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  observation    Observation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  problem       Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)
  goal          BusinessGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  recommendations Recommendation[]
  @@index([organizationId])
  @@index([businessId])
}

model Recommendation {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  observationId  String?
  problemId      String?
  opportunityId  String?
  goalId         String?
  title          String
  description    String?
  reason         String?
  evidence       String?
  expectedOutcome String?
  status         String?
  confidence     String?
  approvalRequired Boolean @default(false)
  sourceType     SourceType @default(SYSTEM)
  knowledgeType  KnowledgeType @default(HYPOTHESIS)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  observation    Observation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  problem       Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  goal          BusinessGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks         Task[]
  @@index([organizationId])
  @@index([businessId])
}

model Task {
  id             String   @id @default(cuid())
  organizationId String
  businessId     String
  recommendationId String?
  title          String
  description    String?
  reason         String?
  evidence       String?
  impact         String?
  effort         String?
  urgency        String?
  confidence     String?
  ownerUserId    String?
  deadline       DateTime?
  expectedOutcome String?
  approvalRequired Boolean @default(false)
  status         String   @default("SUGGESTED")
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sourceType     SourceType @default(SYSTEM)
  knowledgeType  KnowledgeType @default(HYPOTHESIS)
  sourceReference String?
  collectedAt    DateTime?
  freshness      String?
  business       Business @relation(fields: [businessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  @@index([organizationId])
  @@index([businessId])
}

model AuditEvent {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  result         String        @default("success")
  requestId      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          UserAccount?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model ClerkWebhookEvent {
  id          String   @id
  eventType   String
  receivedAt  DateTime @default(now())
  processedAt DateTime?
}

model BrandConfiguration {
  id             String       @id @default(cuid())
  organizationId String       @unique
  name           String
  logoUrl        String?
  primaryColor   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
